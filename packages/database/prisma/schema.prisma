// Prisma schema for Ramesh Art Designer Pro.
// No models yet — scaffold-only. Add one model block per domain entity
// as each business module (design, marketing, finance) is built, and
// keep related models grouped with a comment header per module.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
