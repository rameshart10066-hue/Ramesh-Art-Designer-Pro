{
  "name": "ramesh-art-designer-pro",
  "version": "0.1.0",
  "private": true,
  "description": "Business operations platform for the acrylic products business — design, manufacturing, AI assistance, marketing, and finance modules.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "clean": "npm run clean --workspaces --if-present && rimraf node_modules"
  },
  "devDependencies": {
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.64.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
